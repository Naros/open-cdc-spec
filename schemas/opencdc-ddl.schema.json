{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencdc.org/schemas/opencdc-ddl.schema.json",
  "title": "OpenCDC DDL data payload (Section 9.1; ddl object shape per ddl_capture mode)",
  "type": "object",
  "properties": {
    "table": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "name"
      ]
    },
    "ddl": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string"
        },
        "statement_truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "statement"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "statement"
                ]
              },
              {
                "required": [
                  "statement_truncated"
                ]
              }
            ]
          }
        }
      ]
    },
    "pos": {
      "type": "object",
      "properties": {
        "lsn": {
          "type": "string"
        },
        "source_timestamp": {
          "type": "string"
        },
        "lsn_offset": {
          "type": "integer",
          "minimum": 0
        },
        "native_position": {
          "type": "string"
        }
      },
      "required": [
        "lsn",
        "source_timestamp",
        "lsn_offset"
      ]
    }
  },
  "required": [
    "table",
    "ddl",
    "pos"
  ],
  "additionalProperties": false
}