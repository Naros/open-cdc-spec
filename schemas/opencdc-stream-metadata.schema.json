{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencdc.org/schemas/opencdc-stream-metadata.schema.json",
  "title": "OpenCDC STREAM_METADATA data payload (Sections 10.4, 2.2a, 4.4, 8.4.1)",
  "type": "object",
  "properties": {
    "producer": {
      "type": "string"
    },
    "opencdc_version": {
      "const": "0.3"
    },
    "source_db": {
      "type": "string"
    },
    "capture_mode": {
      "type": "string"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heartbeat_interval_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "ordering_scope": {
      "enum": [
        "stream",
        "channel"
      ]
    },
    "transaction_interleaving": {
      "enum": [
        "none",
        "possible"
      ]
    },
    "transaction_boundaries": {
      "enum": [
        "none",
        "commit_all",
        "commit_multi_event"
      ]
    },
    "transaction_marker_delivery": {
      "enum": [
        "transaction_metadata_channel",
        "per_channel"
      ]
    },
    "transaction_visibility": {
      "enum": [
        "committed_only"
      ]
    },
    "bidirectional": {
      "type": "boolean"
    },
    "ddl_capture": {
      "enum": [
        "verbatim",
        "structural",
        "none"
      ]
    },
    "session_aware": {
      "type": "boolean"
    },
    "schema_delivery": {
      "type": "object",
      "properties": {
        "schema_on_change": {
          "const": true
        },
        "schema_on_reconnect": {
          "type": "boolean"
        },
        "schema_on_each_event": {
          "type": "boolean"
        },
        "schema_by_reference": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_on_change"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "schema_on_reconnect": {
              "const": true
            }
          },
          "required": [
            "schema_on_reconnect"
          ]
        },
        {
          "properties": {
            "schema_on_each_event": {
              "const": true
            }
          },
          "required": [
            "schema_on_each_event"
          ]
        }
      ]
    },
    "sequence_continuity": {
      "enum": [
        "guaranteed",
        "best_effort",
        "reset"
      ]
    }
  },
  "required": [
    "producer",
    "opencdc_version",
    "source_db",
    "tables",
    "heartbeat_interval_seconds",
    "ordering_scope",
    "transaction_interleaving",
    "sequence_continuity",
    "schema_delivery"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "transaction_interleaving": {
            "const": "possible"
          }
        }
      },
      "then": {
        "required": [
          "transaction_boundaries",
          "transaction_marker_delivery"
        ],
        "properties": {
          "transaction_boundaries": {
            "const": "commit_all"
          }
        }
      }
    }
  ]
}