{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencdc.org/schemas/opencdc-trx-commit.schema.json",
  "title": "OpenCDC TRX_COMMIT data payload (Section 10.5.3)",
  "type": "object",
  "properties": {
    "cdcxid": {
      "type": "string"
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "pos": {
      "type": "object",
      "properties": {
        "lsn": {
          "type": "string"
        },
        "source_timestamp": {
          "type": "string"
        },
        "lsn_offset": {
          "type": "integer",
          "minimum": 0
        },
        "native_position": {
          "type": "string"
        }
      },
      "required": [
        "lsn",
        "source_timestamp",
        "lsn_offset"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_count",
    "pos"
  ],
  "additionalProperties": false
}